<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="action_gym_member" model="ir.actions.act_window">
        <field name="name">Gym Members</field>
        <field name="res_model">gym.member</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first gym member here!
            </p>
        </field>
    </record>

    <record id="view_gym_member_form" model="ir.ui.view">
        <field name="name">gym.member.form</field>
        <field name="model">gym.member</field>
        <field name="arch" type="xml">
            <form string="Gym Member">
                <sheet>
                    <field name="member_photo" widget="image" class="oe_avatar"/>
                    <field name="test_field"/>
                    <div class="oe_title">
                        <h1>
                            <field name="member_name" placeholder="Member Full Name" required="1" style="color: #000080;"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Basic Information">
                            <field name="age" widget="integer" style="color: #000080;"/>
                            <field name="join_date" style="color: #000080;"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                        
                        
                        <group string="Subscription Details">
                            <field name="membership_type" widget="radio" options="{'horizontal': true}" style="color: #000080;"/>
                            <field name="training_type" widget="radio" options="{'horizontal': true}" style="color: #000080;"/>
                            <field name="subscription_fee" widget="monetary" style="color: #000080;"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Health Notes" name="health_notes_page">
                            <field name="health_notes" placeholder="Enter any health notes or concerns here..." style="color: #000080;"/>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_gym_member_list" model="ir.ui.view">
        <field name="name">gym.member.list</field>
        <field name="model">gym.member</field>
        <field name="arch" type="xml">
            <list string="Gym Members">
                <field name="member_name"/>
                <field name="age"/>
                <field name="membership_type"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_gym_root" name="Gym" sequence="10"/>
    <menuitem id="menu_gym_members" name="Members" parent="menu_gym_root" action="action_gym_member" sequence="20"/>

</odoo>