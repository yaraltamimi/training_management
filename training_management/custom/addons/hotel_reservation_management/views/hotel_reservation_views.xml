<odoo>
    <data>
        <record id="hotel_reservation_view_list" model="ir.ui.view">
            <field name="name">hotel.reservation.view.list</field>
            <field name="model">hotel.reservation</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="duration"/>
                    <field name="guest_id"/>
                    <field name="room_id"/>
                </list>
            </field>
        </record>

        <record id="hotel_reservation_view_form" model="ir.ui.view">
            <field name="name">hotel.reservation.view.form</field>
            <field name="model">hotel.reservation</field>
            <field name="arch" type="xml">
                <form string="Hotel Reservation">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group>
                                <field name="duration"/>
                                <field name="guest_id"/>
                                <field name="room_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hotel_reservation_action" model="ir.actions.act_window">
            <field name="name">Reservations</field>
            <field name="res_model">hotel.reservation</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="hotel_reservation_menu"
                name="Reservations"
                parent="hotel_reservation_management.hotel_root_menu"
                action="hotel_reservation_management.hotel_reservation_action"
                sequence="30"/>
    </data>
</odoo>