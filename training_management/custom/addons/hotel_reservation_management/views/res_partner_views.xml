<odoo>
    <data>

        <record id="view_partner_form_inherit_hotel" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.hotel</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="is_guest"/>
                </xpath>
                
                
                <xpath expr="//field[@name='mobile']" position="replace">
                
                </xpath>
            </field>
        </record>

        
        <record id="hotel_guest_action" model="ir.actions.act_window">
            <field name="name">Guests</field>
            <field name="res_model">res.partner</field>
            <field name="domain">[('is_guest', '=', True)]</field>
            <field name="context">{'default_is_guest': True}</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="hotel_guest_menu"
                name="Guests"
                parent="hotel_reservation_management.hotel_root_menu"
                action="hotel_reservation_management.hotel_guest_action"
                sequence="10"/>
    </data>
</odoo>