<odoo>
    <data>
        <record id="hotel_room_view_list" model="ir.ui.view">
            <field name="name">hotel.room.view.list</field>
            <field name="model">hotel.room</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="is_reserved"/>
                </list>
            </field>
        </record>

        <record id="hotel_room_view_form" model="ir.ui.view">
            <field name="name">hotel.room.view.form</field>
            <field name="model">hotel.room</field>
            <field name="arch" type="xml">
                <form string="Hotel Room">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="capacity"/>
                            <field name="is_reserved"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hotel_room_action" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">hotel.room</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="hotel_room_menu"
                name="Rooms"
                parent="hotel_reservation_management.hotel_root_menu"
                action="hotel_reservation_management.hotel_room_action"
                sequence="20"/>
    </data>
</odoo>