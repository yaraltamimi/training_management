<odoo>
    <record id="school_user_group" model="res.groups">
        <field name="name">School User</field>
    </record>

    <record id="rec_teacher_only_his_student" model="ir.rule">
        <field name="name">teacher.only.his.student</field>
        <field name="model_id" ref="school_management.model_school_student"/>
        <field name="domain_force">[('teacher_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_readonly'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>