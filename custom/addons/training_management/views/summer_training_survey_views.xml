<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <record id="view_summer_training_survey_list" model="ir.ui.view">

        <field name="name">summer.training.survey.list</field>

        <field name="model">summer.training.survey</field>

        <field name="arch" type="xml">

            <list string="Surveys">

                <field name="trainee_id"/>

                <field name="year_id"/>

                <field name="submission_date"/>

                <field name="overall_satisfaction"/>

            </list>

        </field>

    </record>



    <record id="view_summer_training_survey_form" model="ir.ui.view">

        <field name="name">summer.training.survey.form</field>

        <field name="model">summer.training.survey</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <group string="Survey Info">

                            <field name="trainee_id"/>

                            <field name="year_id"/>

                            <field name="submission_date"/>

                        </group>

                    </group>

                    <group string="Ratings">

                        <group>

                            <field name="content_rating"/>

                            <field name="trainer_rating"/>

                        </group>

                        <group>

                            <field name="organization_rating"/>

                            <field name="overall_satisfaction"/>

                        </group>

                    </group>

                    <group string="Comments">

                        <field name="comments" nolabel="1"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>



    <record id="action_summer_training_survey" model="ir.actions.act_window">

        <field name="name">Surveys</field>

        <field name="res_model">summer.training.survey</field>

        <field name="view_mode">list,form</field>

    </record>



    <menuitem id="menu_summer_training_survey" name="Surveys" parent="menu_summer_training_root" action="action_summer_training_survey" sequence="40"/>


</odoo>