<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- قائمة المتدربين العامة (للقراءة والاستعراض فقط) -->
    <record id="view_summer_training_trainee_tree" model="ir.ui.view">
        <field name="name">summer.training.trainee.tree</field>
        <field name="model">summer.training.trainee</field>
        <field name="arch" type="xml">
            <list string="Trainees" create="false" edit="false">
                <field name="name"/>
                <field name="year_id" readonly="1"/>
                <field name="university"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- نموذج المتدرب (عرض البيانات للقراءة فقط) -->
    <record id="view_summer_training_trainee_form" model="ir.ui.view">
        <field name="name">summer.training.trainee.form</field>
        <field name="model">summer.training.trainee</field>
        <field name="arch" type="xml">
            <form string="Trainee" create="false" edit="false">
                <sheet>
                    <group string="Training Year Information">
                        <field name="year_id" readonly="1"/>
                    </group>
                    <group string="Trainee Details">
                        <field name="name" readonly="1"/>
                        <field name="national_id" readonly="1"/>
                        <field name="university" readonly="1"/>
                        <field name="major" readonly="1"/>
                        <field name="state" widget="badge"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_summer_training_trainee" model="ir.actions.act_window">
        <field name="name">Trainees</field>
        <field name="res_model">summer.training.trainee</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Trainees will appear here automatically when added from Training Years.
            </p>
        </field>
    </record>

    <menuitem id="menu_summer_training_trainee" name="Trainees" parent="menu_summer_training_root" action="action_summer_training_trainee" sequence="20"/>

</odoo>