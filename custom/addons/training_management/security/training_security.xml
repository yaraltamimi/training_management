<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_training" model="ir.module.category">
            <field name="name">Training Management</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_training_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_category_training"/>
        </record>

        <record id="group_training_officer" model="res.groups">
            <field name="name">Training Officer</field>
            <field name="category_id" ref="module_category_training"/>
            <field name="implied_ids" eval="[(4, ref('group_training_supervisor'))]"/>
        </record>

        <record id="group_training_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_training"/>
            <field name="implied_ids" eval="[(4, ref('group_training_officer'))]"/>
        </record>

        <record id="group_trainee" model="res.groups">
            <field name="name">Training Trainee</field>
            <field name="category_id" ref="module_category_training"/>
        </record>

        <record id="rule_trainee_see_all_trainees" model="ir.rule">
            <field name="name">Trainee can see all trainees for evaluation</field>
            <field name="model_id" ref="model_summer_training_trainee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_trainee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>