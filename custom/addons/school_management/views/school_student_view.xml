<odoo>
    
    <record model="ir.ui.view" id="school_student_form_view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Student Form">
                <header>
                   
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="draft_action" type="object" string="Move to Draft" class="btn-primary" invisible="state != 'active'"/>
                    
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,inactive"/>
                </header>
                <sheet>
                    <group>
                        <field name="last_name"/>
                        <field name="full_name"/>
                        <field name="student_id"/>
                        <field name="class_id"/>
                        <field name="age"/>
                        <field name="phone"/>
                        <field name="teacher_id" widget="many2one_avatar"/>
                        <field name="is_active_teacher"/>
                        <field name="gender"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record model="ir.ui.view" id="school_student_list_view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list string="Student List">
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="full_name"/>
                <field name="student_id"/>
                <field name="gender"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>

   
    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <menuitem id="school_management_menu" name="School Management" sequence="5"/>
    <menuitem id="school_student_menu" name="Students" parent="school_management_menu" sequence="1" action="action_school_student"/>
</odoo>