<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_summer_training_year_form" model="ir.ui.view">
        <field name="name">summer.training.year.form</field>
        <field name="model">summer.training.year</field>
        <field name="arch" type="xml">
            <form string="Training Year">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,ongoing,done,archived"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="weeks_count"/>
                        <field name="total_hours"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List (Tree) View -->
    <record id="view_summer_training_year_tree" model="ir.ui.view">
        <field name="name">summer.training.year.tree</field>
        <field name="model">summer.training.year</field>
        <field name="arch" type="xml">
            <list string="Training Years">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="weeks_count"/>
                <field name="total_hours"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_summer_training_year" model="ir.actions.act_window">
        <field name="name">Training Years</field>
        <field name="res_model">summer.training.year</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_summer_training_root" name="Training Management"/>
    <menuitem id="menu_summer_training_year" name="Training Years" parent="menu_summer_training_root" action="action_summer_training_year"/>

</odoo>